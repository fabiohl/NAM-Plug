import { SelectorButton } from "SelectorButton.slint";

export component ModelCard inherits Rectangle {
    in property <string> model-name: "No model loaded";
    in property <string> model-arch: "WaveNet (Standard)";
    in property <string> model-sample-rate: "48 kHz";
    in property <bool> has-model: false;
    in property <bool> is-loading: false;
    in property <bool> is-error: false;
    in property <string> error-message: "";
    in property <color> accent-color: #00D4AA;

    callback load-clicked();
    callback clear-clicked();

    background: transparent;

    VerticalLayout {
        spacing: 3px;
        alignment: space-between;

        // Card Header Title
        HorizontalLayout {
            alignment: space-between;
            height: 12px;
            Text {
                text: "AMP MODEL";
                font-size: 8.5px;
                font-weight: 700;
                color: #8fa1b3;
                vertical-alignment: center;
            }
            if root.is-loading : Text {
                text: "LOADING...";
                font-size: 8px;
                font-weight: 700;
                color: #F5A623;
                vertical-alignment: center;
            }
            if !root.is-loading && root.has-model : Rectangle {
                background: #1c3628;
                border-radius: 2px;
                border-width: 0.5px;
                border-color: #43E97B;
                height: 12px;
                HorizontalLayout {
                    padding-left: 3px;
                    padding-right: 3px;
                    Text {
                        text: "AMP ON";
                        font-size: 7.5px;
                        font-weight: 800;
                        color: #43E97B;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Active Model Display Surface
        Rectangle {
            height: 44px;
            background: #141518;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.is-error ? #F74E4E : #2E3440;
            clip: true;

            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: center;
                spacing: 2px;

                if root.is-loading : Text {
                    text: "Loading weights...";
                    font-size: 9.5px;
                    font-weight: 600;
                    color: #F5A623;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if root.is-error : Text {
                    text: root.error-message != "" ? root.error-message : "Load failed";
                    font-size: 9.5px;
                    font-weight: 600;
                    color: #F74E4E;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if !root.is-loading && !root.is-error : Text {
                    text: root.model-name;
                    font-size: 10px;
                    font-weight: 600;
                    color: (!root.has-model || root.model-name == "No model loaded") ? #8fa1b3 : #E5E9F0;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                // Subtitle metadata: Neural Architecture and Native Sample Rate
                if !root.is-error : Text {
                    text: (!root.has-model || root.model-name == "No model loaded") ? "Select .nam profile" :
                        (root.model-arch != "" ? (root.model-arch + " • " + root.model-sample-rate) : root.model-sample-rate);
                    font-size: 8.5px;
                    color: #7f8c8d;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Action Trigger Row (Load Model + Contextual Clear)
        HorizontalLayout {
            spacing: 3px;
            height: 24px;

            SelectorButton {
                text: "LOAD .NAM";
                badge: "AI";
                accent-color: root.accent-color;
                clicked => {
                    root.load-clicked();
                }
            }

            if root.has-model : touch_clear := TouchArea {
                width: 24px;
                mouse-cursor: pointer;
                clicked => {
                    root.clear-clicked();
                }

                Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    background: touch_clear.pressed ? #171012 : (touch_clear.has-hover ? #2e1a1d : #201517);
                    border-color: touch_clear.has-hover ? #F74E4E : #3a2226;
                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }

                    Text {
                        text: "✕";
                        font-size: 11px;
                        font-weight: 700;
                        color: touch_clear.has-hover ? #F74E4E : #d25a66;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
