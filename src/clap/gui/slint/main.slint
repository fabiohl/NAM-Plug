import { RotaryKnob } from "RotaryKnob.slint";
import { VuMeter } from "VuMeter.slint";
import { ToggleSwitch } from "ToggleSwitch.slint";
import { LedIndicator } from "LedIndicator.slint";
import { SelectorButton } from "SelectorButton.slint";
import { ModelCard } from "ModelCard.slint";
import { IrCard } from "IrCard.slint";

export component MainWindow inherits Window {
    title: "NAM-Plug";
    width: 600px;
    height: 312px;
    background: #1A1D23;
    default-font-family: "sans-serif";

    // ── Zone 1 Properties: Model & IR Metadata ───────────────
    in-out property <string> model_name: "No model loaded";
    in-out property <string> model_arch: "No model loaded";
    in-out property <string> model_sample_rate: "—";
    in-out property <bool> has_model: false;
    in-out property <bool> model_loading: false;
    in-out property <bool> model_error: false;
    in-out property <string> model_error_msg: "";

    in-out property <string> ir_name: "No IR loaded";
    in-out property <string> ir_status: "—";
    in-out property <string> ir_policy_label: "Peak";
    in-out property <bool> has_ir: false;
    in-out property <bool> ir_loading: false;
    in-out property <bool> ir_error: false;
    in-out property <string> ir_error_msg: "";

    // ── Zone 2 Properties: Analog Gain & Gate Stages ──────────
    in-out property <float> input_gain_db: 0.0;
    in-out property <float> output_gain_db: -3.0;
    in-out property <float> gate_thresh_db: -90.0;
    in-out property <string> input_gain_text: "0.0 dB";
    in-out property <string> output_gain_text: "-3.0 dB";
    in-out property <string> gate_thresh_text: "OFF";
    in-out property <bool> gate_active: false;
    in-out property <int> gate_mode: 0; // 0: Silence, 1: Musical
    in-out property <int> oversample_mode: 0; // 0: Off, 1: 2x, 2: 4x
    in-out property <int> activation_mode: 1; // 1: Standard, 0: Fast
    in-out property <bool> calibrate_input: false;
    in-out property <float> input_calibration_level_dbu: 12.0;
    in-out property <string> input_calibration_text: "12.0 dBu";
    in-out property <int> output_mode: 1; // 0: Raw, 1: Normalized, 2: Calibrated
    in-out property <bool> has_input_cal_meta: false;
    in-out property <bool> has_output_cal_meta: false;
    in-out property <bool> has_loudness_meta: false;

    // ── Zone 3 Properties: Telemetry & VU Meters ──────────────
    in-out property <float> in_peak_l: 0.0;
    in-out property <float> in_peak_r: 0.0;
    in-out property <float> in_peak_hold_l: 0.0;
    in-out property <float> in_peak_hold_r: 0.0;
    in-out property <float> in_rms_l: 0.0;
    in-out property <float> in_rms_r: 0.0;
    in-out property <bool> in_clip_active: false;

    in-out property <float> peak_l: 0.72;
    in-out property <float> peak_r: 0.68;
    in-out property <float> peak_hold_l: 0.78;
    in-out property <float> peak_hold_r: 0.74;
    in-out property <float> rms_l: 0.0;
    in-out property <float> rms_r: 0.0;
    in-out property <bool> clip_active: false;
    in-out property <bool> is_stereo: true;

    // ── Zone 4 Properties: Master Bypass ──────────────────────
    in-out property <bool> bypass_active: false;

    // ── Zone 5 Properties: Status Bar & Host Telemetry ────────
    in-out property <string> sample_rate_text: "48000 Hz";
    in-out property <string> buffer_size_text: "— spl";
    in-out property <string> latency_text: "0 spl (0.0 ms)";
    in-out property <string> channels_text: "Stereo";
    // "—" is the honest placeholder until a real per-block DSP-load metric is
    // wired (Finding F6 / T3.6.3): the preview binary and the design-time
    // default previously showed a hard-coded "1.4% DSP" that never reflected
    // the actually loaded model or host block size.
    in-out property <string> dsp_load_text: "—";
    in-out property <bool> xrun_active: false;
    in-out property <string> oversample_text: "1x (Off)";
    in-out property <string> simd_badge: "AVX2+FMA";
    in-out property <string> backend_text: "Wayland Native";
    in-out property <bool> alert_active: false;
    in-out property <string> alert_text: "";
    in-out property <color> alert_color: #EBCB8B;

    // ── Host Interaction Callbacks ────────────────────────────
    callback toggle_bypass();
    callback load_model_clicked();
    callback clear_model_clicked();
    callback load_ir_clicked();
    callback clear_ir_clicked();
    callback cycle_ir_policy_clicked();
    callback reset_clip_clicked();
    callback reset_in_clip_clicked();
    callback input_gain_changed(float);
    callback input_gain_gesture_begin();
    callback input_gain_gesture_end();
    callback output_gain_changed(float);
    callback output_gain_gesture_begin();
    callback output_gain_gesture_end();
    callback gate_thresh_changed(float);
    callback gate_thresh_gesture_begin();
    callback gate_thresh_gesture_end();
    callback gate_mode_changed(int);
    callback oversample_changed(int);
    callback activation_changed(int);
    callback cycle_oversample();
    callback calibrate_input_toggled();
    callback input_calibration_level_changed(float);
    callback output_mode_changed(int);
    // Lifecycle bridge: invoked by the CLAP gui show()/hide() paths so the
    // 60 Hz telemetry timer can be suspended with the window (F-UX-08).
    callback set_telemetry_active(bool);

    VerticalLayout {
        padding: 6px;
        spacing: 5px;

        // ═════════════════════════════════════════════════════════════════════
        // Upper Area: Zones 1, 2, 3, 4 (269 px exact height)
        // ═════════════════════════════════════════════════════════════════════
        HorizontalLayout {
            height: 269px;
            spacing: 6px;

            // ── Zone 1: Identity, Model & IR Cards (145 px width) ───────────
            Rectangle {
                width: 145px;
                background: #232830;
                border-radius: 4px;
                border-width: 1px;
                border-color: #2E3440;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    alignment: space-between;

                    // Brand Header
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "NAM-Plug⚡";
                                font-size: 13px;
                                font-weight: 800;
                                color: #00D4AA;
                            }
                            Rectangle {
                                background: #2E3440;
                                border-radius: 3px;
                                height: 16px;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: root.simd_badge;
                                        font-size: 8.5px;
                                        font-weight: 700;
                                        color: #8fa1b3;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Neural Amp Modeler";
                                font-size: 8.5px;
                                color: #8fa1b3;
                            }
                            Text {
                                text: "v1.0.0 • CLAP";
                                font-size: 8.5px;
                                color: #636e7b;
                            }
                        }
                    }

                    // Model Card
                    ModelCard {
                        model-name: root.model_name;
                        model-arch: root.model_arch;
                        model-sample-rate: root.model_sample_rate;
                        has-model: root.has_model;
                        is-loading: root.model_loading;
                        is-error: root.model_error;
                        error-message: root.model_error_msg;
                        accent-color: #00D4AA;
                        load-clicked => { root.load_model_clicked(); }
                        clear-clicked => { root.clear_model_clicked(); }
                    }

                    Rectangle {
                        height: 1px;
                        background: #2E3440;
                    }

                    // Cabinet IR Card
                    IrCard {
                        ir-name: root.ir_name;
                        ir-status: root.ir_status;
                        ir-policy-label: root.ir_policy_label;
                        has-ir: root.has_ir;
                        is-loading: root.ir_loading;
                        is-error: root.ir_error;
                        error-message: root.ir_error_msg;
                        accent-color: #3498db;
                        load-clicked => { root.load_ir_clicked(); }
                        clear-clicked => { root.clear_ir_clicked(); }
                        cycle-policy-clicked => { root.cycle_ir_policy_clicked(); }
                    }
                }
            }

            // ── Zone 2: Analog Gain & Gate Stages (255 px width) ────────────
            Rectangle {
                width: 255px;
                background: #232830;
                border-radius: 4px;
                border-width: 1px;
                border-color: #2E3440;
                opacity: root.bypass_active ? 0.45 : 1.0;
                animate opacity { duration: 120ms; }

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    alignment: space-between;

                    // Section Title
                    Text {
                        text: "ANALOG GAIN & GATE STAGES";
                        font-size: 8.5px;
                        font-weight: 700;
                        color: #8fa1b3;
                        horizontal-alignment: center;
                    }

                    // 3 Rotary Knobs (Input, Output, Gate)
                    HorizontalLayout {
                        alignment: space-around;
                        spacing: 4px;

                        // Input Gain Knob (-20 to +20 dB)
                        RotaryKnob {
                            label: "INPUT";
                            value <=> root.input_gain_db;
                            minimum: -20.0;
                            maximum: 20.0;
                            default-value: 0.0;
                            accent-color: #00D4AA;
                            editing-started(_) => {
                                root.input_gain_gesture_begin();
                            }
                            value-changed(v) => {
                                root.input_gain_text = (v > 0.0 ? "+" : "") + Math.round(v * 10.0) / 10.0 + " dB";
                                root.input_gain_changed(v);
                            }
                            editing-finished(_) => {
                                root.input_gain_gesture_end();
                            }
                        }

                        // Output Gain Knob (-40 to +20 dB)
                        RotaryKnob {
                            label: "OUTPUT";
                            value <=> root.output_gain_db;
                            minimum: -40.0;
                            maximum: 20.0;
                            default-value: -3.0;
                            accent-color: #3498db;
                            editing-started(_) => {
                                root.output_gain_gesture_begin();
                            }
                            value-changed(v) => {
                                root.output_gain_text = (v > 0.0 ? "+" : "") + Math.round(v * 10.0) / 10.0 + " dB";
                                root.output_gain_changed(v);
                            }
                            editing-finished(_) => {
                                root.output_gain_gesture_end();
                            }
                        }

                        // Gate Threshold Knob (-90 to 0 dB)
                        RotaryKnob {
                            label: "GATE";
                            value <=> root.gate_thresh_db;
                            minimum: -90.0;
                            maximum: 0.0;
                            default-value: -90.0;
                            accent-color: #F5A623;
                            editing-started(_) => {
                                root.gate_thresh_gesture_begin();
                            }
                            value-changed(v) => {
                                root.gate_thresh_text = Math.round(v) <= -90 ? "OFF" : Math.round(v) + " dB";
                                root.gate_thresh_changed(v);
                            }
                            editing-finished(_) => {
                                root.gate_thresh_gesture_end();
                            }
                        }
                    }

                    // Noise Gate Dynamic Status LED & Mode Toggle
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 6px;
                        padding-right: 6px;
                        height: 18px;

                        LedIndicator {
                            active: root.gate_active;
                            color-on: #43E97B;
                            color-off: #2E3440;
                            label: root.gate_active ? "GATE ACTIVE" : "GATE OPEN";
                            size: 8px;
                        }

                        HorizontalLayout {
                            spacing: 2px;
                            alignment: end;
                            TouchArea {
                                width: 24px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.gate_mode = 0;
                                    root.gate_mode_changed(0);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.gate_mode == 0 ? #F5A623 : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.gate_mode == 0 ? #F5A623 : #2E3440;
                                    Text {
                                        text: "Sil";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: root.gate_mode == 0 ? #121315 : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            TouchArea {
                                width: 26px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.gate_mode = 1;
                                    root.gate_mode_changed(1);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.gate_mode == 1 ? #00D4AA : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.gate_mode == 1 ? #00D4AA : #2E3440;
                                    Text {
                                        text: "Mus";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: root.gate_mode == 1 ? #121315 : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #2E3440;
                    }

                    // Sub-Controls: Oversampling & Activation Precision
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 6px;
                        padding-right: 6px;
                        height: 20px;

                        // Oversampling Segmented Switch (Off, 2x, 4x)
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            Text {
                                text: "Oversample:";
                                font-size: 8.5px;
                                font-weight: 700;
                                color: #8fa1b3;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 22px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.oversample_mode = 0;
                                    root.oversample_text = "1x (Off)";
                                    root.oversample_changed(0);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.oversample_mode == 0 ? #00D4AA : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.oversample_mode == 0 ? #00D4AA : #2E3440;
                                    Text {
                                        text: "Off";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: root.oversample_mode == 0 ? #121315 : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            TouchArea {
                                width: 20px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.oversample_mode = 1;
                                    root.oversample_text = "2x (HQ)";
                                    root.oversample_changed(1);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.oversample_mode == 1 ? #00D4AA : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.oversample_mode == 1 ? #00D4AA : #2E3440;
                                    Text {
                                        text: "2×";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: root.oversample_mode == 1 ? #121315 : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            TouchArea {
                                width: 20px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.oversample_mode = 2;
                                    root.oversample_text = "4x (Ultra)";
                                    root.oversample_changed(2);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.oversample_mode == 2 ? #00D4AA : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.oversample_mode == 2 ? #00D4AA : #2E3440;
                                    Text {
                                        text: "4×";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: root.oversample_mode == 2 ? #121315 : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Activation Precision Segmented Switch (Standard, Fast)
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: end;
                            Text {
                                text: "Precision:";
                                font-size: 8.5px;
                                font-weight: 700;
                                color: #8fa1b3;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 26px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.activation_mode = 1;
                                    root.activation_changed(1);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.activation_mode == 1 ? #3498db : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.activation_mode == 1 ? #3498db : #2E3440;
                                    Text {
                                        text: "Std";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: root.activation_mode == 1 ? #ffffff : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            TouchArea {
                                width: 26px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.activation_mode = 0;
                                    root.activation_changed(0);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.activation_mode == 0 ? #3498db : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.activation_mode == 0 ? #3498db : #2E3440;
                                    Text {
                                        text: "Fast";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: root.activation_mode == 0 ? #ffffff : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Calibration Separator
                    Rectangle {
                        height: 1px;
                        background: #2E3440;
                    }

                    // Input Calibration & Output Mode Row
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 6px;
                        padding-right: 6px;
                        height: 22px;

                        // Input Calibration Toggle + Stepper (dBu)
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            in property <bool> cal_in_available: !root.has_model || root.has_input_cal_meta;

                            TouchArea {
                                width: 42px;
                                enabled: parent.cal_in_available;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => {
                                    root.calibrate_input_toggled();
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    opacity: (!root.has_model || root.has_input_cal_meta) ? 1.0 : 0.45;
                                    background: root.calibrate_input ? #00D4AA : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.calibrate_input ? #00D4AA : #2E3440;
                                    Text {
                                        text: "CAL IN";
                                        font-size: 7.5px;
                                        font-weight: 700;
                                        color: root.calibrate_input ? #121315 : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            TouchArea {
                                width: 14px;
                                enabled: (!root.has_model || root.has_input_cal_meta) && root.calibrate_input;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => {
                                    root.input_calibration_level_changed(Math.max(-60.0, root.input_calibration_level_dbu - 1.0));
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    opacity: ((!root.has_model || root.has_input_cal_meta) && root.calibrate_input) ? 1.0 : 0.4;
                                    background: parent.has-hover ? #2e3440 : #1a1d23;
                                    border-width: 0.5px;
                                    border-color: #2E3440;
                                    Text {
                                        text: "-";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #cdd6f4;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                width: 50px;
                                opacity: (!root.has_model || root.has_input_cal_meta) ? 1.0 : 0.45;
                                Text {
                                    text: (root.has_model && !root.has_input_cal_meta) ? "No meta" : root.input_calibration_text;
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: (root.calibrate_input && (!root.has_model || root.has_input_cal_meta)) ? #e0e6ed : #8fa1b3;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                width: 14px;
                                enabled: (!root.has_model || root.has_input_cal_meta) && root.calibrate_input;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => {
                                    root.input_calibration_level_changed(Math.min(60.0, root.input_calibration_level_dbu + 1.0));
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    opacity: ((!root.has_model || root.has_input_cal_meta) && root.calibrate_input) ? 1.0 : 0.4;
                                    background: parent.has-hover ? #2e3440 : #1a1d23;
                                    border-width: 0.5px;
                                    border-color: #2E3440;
                                    Text {
                                        text: "+";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #cdd6f4;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Output Mode Segmented Switch (Raw, Norm, Cal)
                        HorizontalLayout {
                            spacing: 2px;
                            alignment: end;
                            Text {
                                text: "Out:";
                                font-size: 8px;
                                font-weight: 700;
                                color: #8fa1b3;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 25px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.output_mode = 0;
                                    root.output_mode_changed(0);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    background: root.output_mode == 0 ? #3498db : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.output_mode == 0 ? #3498db : #2E3440;
                                    Text {
                                        text: "Raw";
                                        font-size: 7.5px;
                                        font-weight: 700;
                                        color: root.output_mode == 0 ? #ffffff : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            TouchArea {
                                width: 29px;
                                enabled: !root.has_model || root.has_loudness_meta;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => {
                                    root.output_mode = 1;
                                    root.output_mode_changed(1);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    opacity: (!root.has_model || root.has_loudness_meta) ? 1.0 : 0.4;
                                    background: root.output_mode == 1 ? #3498db : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.output_mode == 1 ? #3498db : #2E3440;
                                    Text {
                                        text: "Norm";
                                        font-size: 7.5px;
                                        font-weight: 700;
                                        color: root.output_mode == 1 ? #ffffff : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            TouchArea {
                                width: 22px;
                                enabled: !root.has_model || root.has_output_cal_meta;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => {
                                    root.output_mode = 2;
                                    root.output_mode_changed(2);
                                }
                                Rectangle {
                                    border-radius: 2px;
                                    opacity: (!root.has_model || root.has_output_cal_meta) ? 1.0 : 0.4;
                                    background: root.output_mode == 2 ? #3498db : (parent.has-hover ? #2e3440 : #1a1d23);
                                    border-width: 0.5px;
                                    border-color: root.output_mode == 2 ? #3498db : #2E3440;
                                    Text {
                                        text: "Cal";
                                        font-size: 7.5px;
                                        font-weight: 700;
                                        color: root.output_mode == 2 ? #ffffff : #8fa1b3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Zone 3: High-Res Peak & VU Meters (96 px width) ─────────────
            Rectangle {
                width: 96px;
                background: #232830;
                border-radius: 4px;
                border-width: 1px;
                border-color: #2E3440;
                opacity: root.bypass_active ? 0.45 : 1.0;
                animate opacity { duration: 120ms; }

                VerticalLayout {
                    padding: 4px;
                    alignment: center;

                    VuMeter {
                        stereo: root.is_stereo;
                        in-level-l: root.in_peak_l;
                        in-level-r: root.in_peak_r;
                        in-peak-hold-l: root.in_peak_hold_l;
                        in-peak-hold-r: root.in_peak_hold_r;
                        in-rms-l: root.in_rms_l;
                        in-rms-r: root.in_rms_r;
                        in-clipped <=> root.in_clip_active;
                        reset-in-clip => { root.reset_in_clip_clicked(); }

                        level-l: root.peak_l;
                        level-r: root.peak_r;
                        peak-hold-l: root.peak_hold_l;
                        peak-hold-r: root.peak_hold_r;
                        rms-l: root.rms_l;
                        rms-r: root.rms_r;
                        clipped <=> root.clip_active;
                        reset-clip => { root.reset_clip_clicked(); }
                    }
                }
            }

            // ── Zone 4: Master Bypass Control (74 px width) ──────────────────
            Rectangle {
                width: 74px;
                background: #232830;
                border-radius: 4px;
                border-width: 1px;
                border-color: #2E3440;

                VerticalLayout {
                    padding: 8px;
                    alignment: space-around;

                    Text {
                        text: "MASTER";
                        font-size: 9px;
                        font-weight: 700;
                        color: #8fa1b3;
                        horizontal-alignment: center;
                    }

                    // Master Status LED Indicator
                    HorizontalLayout {
                        alignment: center;
                        LedIndicator {
                            active: !root.bypass_active;
                            color-on: #43E97B;
                            color-off: #F74E4E;
                            size: 10px;
                        }
                    }

                    // Hardware Toggle Switch
                    HorizontalLayout {
                        alignment: center;
                        ToggleSwitch {
                            checked: !root.bypass_active;
                            active-color: #43E97B;
                            inactive-color: #4A4F5A;
                            toggled(active) => {
                                root.bypass_active = !active;
                                root.toggle_bypass();
                            }
                        }
                    }

                    Text {
                        text: root.bypass_active ? "BYPASS" : "DSP ACTIVE";
                        font-size: 8px;
                        color: root.bypass_active ? #F74E4E : #43E97B;
                        horizontal-alignment: center;
                        font-weight: 700;
                        animate color { duration: 100ms; }
                    }
                }
            }
        }

        // ═════════════════════════════════════════════════════════════════════
        // Zone 5: Status Bar / Footer (26 px exact height)
        // ═════════════════════════════════════════════════════════════════════
        Rectangle {
            height: 26px;
            background: #141518;
            border-radius: 3px;
            border-width: 1px;
            border-color: #2E3440;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                // Left telemetry group
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "SR: " + root.sample_rate_text;
                        font-size: 9px;
                        color: #8fa1b3;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "BUF: " + root.buffer_size_text;
                        font-size: 9px;
                        color: #8fa1b3;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "LAT: " + root.latency_text;
                        font-size: 9px;
                        color: #8fa1b3;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "CH: " + root.channels_text;
                        font-size: 9px;
                        color: #8fa1b3;
                        vertical-alignment: center;
                    }
                }

                // Right diagnostic group
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    HorizontalLayout {
                        spacing: 5px;
                        alignment: center;

                        LedIndicator {
                            active: root.xrun_active;
                            color-on: #F74E4E;
                            color-off: #2E3440;
                            size: 7px;
                        }

                        dsp_touch := TouchArea {
                            mouse-cursor: pointer;
                            Text {
                                text: root.dsp_load_text;
                                font-size: 9px;
                                font-weight: 700;
                                color: root.xrun_active ? #F74E4E : #43E97B;
                                vertical-alignment: center;
                            }

                            if dsp_touch.has-hover : Rectangle {
                                x: -220px;
                                y: -24px;
                                width: 250px;
                                height: 20px;
                                background: #1a1d23;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #3b4252;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "Reduza oversampling ou habilite computação adaptativa";
                                        font-size: 8px;
                                        color: #d8dee9;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    if root.alert_active : Rectangle {
                        background: #1a1d23;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.alert_color;
                        height: 16px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            LedIndicator {
                                active: true;
                                color-on: root.alert_color;
                                color-off: #2E3440;
                                size: 6px;
                            }

                            Text {
                                text: root.alert_text;
                                font-size: 8px;
                                font-weight: 700;
                                color: root.alert_color;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: root.backend_text;
                        font-size: 9px;
                        color: #636e7b;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
