export component VuMeter inherits Rectangle {
    in property <float> in-level-l: 0.0;
    in property <float> in-level-r: 0.0;
    in property <float> in-peak-hold-l: 0.0;
    in property <float> in-peak-hold-r: 0.0;
    in property <float> in-rms-l: 0.0;
    in property <float> in-rms-r: 0.0;

    in property <float> level-l: 0.0;
    in property <float> level-r: 0.0;
    in property <float> peak-hold-l: 0.0;
    in property <float> peak-hold-r: 0.0;
    in property <float> rms-l: 0.0;
    in property <float> rms-r: 0.0;

    in property <bool> stereo: true;
    in-out property <bool> clipped: false;
    in-out property <bool> in-clipped: false;

    callback reset-clip();
    callback reset-in-clip();

    height: 216px;
    background: transparent;

    VerticalLayout {
        padding: 4px;
        spacing: 6px;

        // Top Header: IN Clip & OUT Clip LEDs
        HorizontalLayout {
            alignment: space-between;
            height: 16px;

            // IN Clip LED
            TouchArea {
                width: 38px;
                height: 14px;
                clicked => {
                    root.in-clipped = false;
                    root.reset-in-clip();
                }

                Rectangle {
                    width: 36px;
                    height: 12px;
                    border-radius: 2px;
                    background: root.in-clipped ? #F74E4E : (parent.has-hover ? #3d2224 : #281819);
                    border-width: 1px;
                    border-color: root.in-clipped ? #ff7675 : #3f2628;
                    animate background { duration: 100ms; }

                    Text {
                        text: "IN CLIP";
                        font-size: 6px;
                        font-weight: 800;
                        color: root.in-clipped ? #ffffff : #5c3538;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // OUT Clip LED
            TouchArea {
                width: 42px;
                height: 14px;
                clicked => {
                    root.clipped = false;
                    root.reset-clip();
                }

                Rectangle {
                    width: 40px;
                    height: 12px;
                    border-radius: 2px;
                    background: root.clipped ? #F74E4E : (parent.has-hover ? #3d2224 : #281819);
                    border-width: 1px;
                    border-color: root.clipped ? #ff7675 : #3f2628;
                    animate background { duration: 100ms; }

                    Text {
                        text: "OUT CLIP";
                        font-size: 6px;
                        font-weight: 800;
                        color: root.clipped ? #ffffff : #5c3538;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Main Metering Canvas: IN Columns + dB Scale + OUT Columns
        HorizontalLayout {
            alignment: center;
            spacing: 3px;
            height: 168px;

            // ── Input Meter Section ─────────────────────────────────────────
            VerticalLayout {
                alignment: space-between;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    // IN Left Channel
                    VerticalLayout {
                        width: root.stereo ? 8px : 14px;
                        spacing: 2px;

                        Rectangle {
                            width: parent.width;
                            height: 150px;
                            background: #111215;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: #2b2e34;
                            clip: true;

                            // Peak Ballistic Signal Fill (semi-transparent)
                            Rectangle {
                                width: parent.width - 2px;
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.in-level-l));
                                y: parent.height - self.height - 1px;
                                x: 1px;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.5;
                                border-radius: 1px;
                            }

                            // RMS / Energy Core Fill (solid)
                            Rectangle {
                                width: Math.max(2px, parent.width - 4px);
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.in-rms-l));
                                y: parent.height - self.height - 1px;
                                x: (parent.width - self.width) / 2;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.95;
                                border-radius: 1px;
                            }

                            // Peak Hold Marker Line
                            if root.in-peak-hold-l > 0.02 : Rectangle {
                                width: parent.width - 2px;
                                height: 2px;
                                y: Math.max(1px, parent.height - (parent.height - 2px) * Math.min(1.0, root.in-peak-hold-l) - 2px);
                                x: 1px;
                                background: root.in-peak-hold-l >= 0.95 ? #F74E4E : (root.in-peak-hold-l >= 0.75 ? #F5CE62 : #43E97B);
                            }
                        }
                    }

                    // IN Right Channel (when stereo)
                    if root.stereo : VerticalLayout {
                        width: 8px;
                        spacing: 2px;

                        Rectangle {
                            width: parent.width;
                            height: 150px;
                            background: #111215;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: #2b2e34;
                            clip: true;

                            // Peak Ballistic Signal Fill (semi-transparent)
                            Rectangle {
                                width: parent.width - 2px;
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.in-level-r));
                                y: parent.height - self.height - 1px;
                                x: 1px;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.5;
                                border-radius: 1px;
                            }

                            // RMS / Energy Core Fill (solid)
                            Rectangle {
                                width: Math.max(2px, parent.width - 4px);
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.in-rms-r));
                                y: parent.height - self.height - 1px;
                                x: (parent.width - self.width) / 2;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.95;
                                border-radius: 1px;
                            }

                            // Peak Hold Marker Line
                            if root.in-peak-hold-r > 0.02 : Rectangle {
                                width: parent.width - 2px;
                                height: 2px;
                                y: Math.max(1px, parent.height - (parent.height - 2px) * Math.min(1.0, root.in-peak-hold-r) - 2px);
                                x: 1px;
                                background: root.in-peak-hold-r >= 0.95 ? #F74E4E : (root.in-peak-hold-r >= 0.75 ? #F5CE62 : #43E97B);
                            }
                        }
                    }
                }

                Text {
                    text: "IN";
                    font-size: 8px;
                    font-weight: 700;
                    color: #7f8c8d;
                    horizontal-alignment: center;
                }
            }

            // ── dB Graduation Scale (Center) ─────────────────────────────────
            VerticalLayout {
                width: 14px;
                alignment: space-between;
                padding-top: 2px;
                padding-bottom: 12px;

                Text { text: " 0"; font-size: 7.5px; font-weight: 700; color: #F74E4E; horizontal-alignment: center; }
                Text { text: "-3"; font-size: 7.5px; font-weight: 600; color: #F5CE62; horizontal-alignment: center; }
                Text { text: "-6"; font-size: 7.5px; color: #a6b0be; horizontal-alignment: center; }
                Text { text: "-12"; font-size: 7.5px; color: #7f8c8d; horizontal-alignment: center; }
                Text { text: "-18"; font-size: 7.5px; font-weight: 600; color: #43E97B; horizontal-alignment: center; }
                Text { text: "-24"; font-size: 7.5px; color: #636e7b; horizontal-alignment: center; }
                Text { text: "-36"; font-size: 7.5px; color: #505963; horizontal-alignment: center; }
                Text { text: "-48"; font-size: 7.5px; color: #3e444c; horizontal-alignment: center; }
            }

            // ── Output Meter Section ────────────────────────────────────────
            VerticalLayout {
                alignment: space-between;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    // OUT Left Channel
                    VerticalLayout {
                        width: root.stereo ? 8px : 14px;
                        spacing: 2px;

                        Rectangle {
                            width: parent.width;
                            height: 150px;
                            background: #111215;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: #2b2e34;
                            clip: true;

                            // Peak Ballistic Signal Fill (semi-transparent)
                            Rectangle {
                                width: parent.width - 2px;
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.level-l));
                                y: parent.height - self.height - 1px;
                                x: 1px;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.5;
                                border-radius: 1px;
                            }

                            // RMS / Energy Core Fill (solid)
                            Rectangle {
                                width: Math.max(2px, parent.width - 4px);
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.rms-l));
                                y: parent.height - self.height - 1px;
                                x: (parent.width - self.width) / 2;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.95;
                                border-radius: 1px;
                            }

                            // Peak Hold Marker Line
                            if root.peak-hold-l > 0.02 : Rectangle {
                                width: parent.width - 2px;
                                height: 2px;
                                y: Math.max(1px, parent.height - (parent.height - 2px) * Math.min(1.0, root.peak-hold-l) - 2px);
                                x: 1px;
                                background: root.peak-hold-l >= 0.95 ? #F74E4E : (root.peak-hold-l >= 0.75 ? #F5CE62 : #43E97B);
                            }
                        }
                    }

                    // OUT Right Channel (when stereo)
                    if root.stereo : VerticalLayout {
                        width: 8px;
                        spacing: 2px;

                        Rectangle {
                            width: parent.width;
                            height: 150px;
                            background: #111215;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: #2b2e34;
                            clip: true;

                            // Peak Ballistic Signal Fill (semi-transparent)
                            Rectangle {
                                width: parent.width - 2px;
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.level-r));
                                y: parent.height - self.height - 1px;
                                x: 1px;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.5;
                                border-radius: 1px;
                            }

                            // RMS / Energy Core Fill (solid)
                            Rectangle {
                                width: Math.max(2px, parent.width - 4px);
                                height: (parent.height - 2px) * Math.max(0.0, Math.min(1.0, root.rms-r));
                                y: parent.height - self.height - 1px;
                                x: (parent.width - self.width) / 2;
                                background: @linear-gradient(180deg, #F74E4E 0%, #F5CE62 18%, #43E97B 55%, #2ecc71 100%);
                                opacity: 0.95;
                                border-radius: 1px;
                            }

                            // Peak Hold Marker Line
                            if root.peak-hold-r > 0.02 : Rectangle {
                                width: parent.width - 2px;
                                height: 2px;
                                y: Math.max(1px, parent.height - (parent.height - 2px) * Math.min(1.0, root.peak-hold-r) - 2px);
                                x: 1px;
                                background: root.peak-hold-r >= 0.95 ? #F74E4E : (root.peak-hold-r >= 0.75 ? #F5CE62 : #43E97B);
                            }
                        }
                    }
                }

                Text {
                    text: "OUT";
                    font-size: 8px;
                    font-weight: 700;
                    color: #7f8c8d;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
