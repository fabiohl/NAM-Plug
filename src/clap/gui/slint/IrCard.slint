import { SelectorButton } from "SelectorButton.slint";

export component IrCard inherits Rectangle {
    in property <string> ir-name: "No cabinet loaded";
    in property <string> ir-status: "—";
    in property <string> ir-policy-label: "Peak";
    in property <string> cab-kind-label: "CAB";
    in property <string> cab-detail: "";
    in property <bool> cab-is-neural: false;
    in property <bool> cab-bypassed: false;
    in property <bool> has-ir: false;
    in property <bool> is-loading: false;
    in property <bool> is-error: false;
    in property <string> error-message: "";
    in property <color> accent-color: #3498db;

    callback load-clicked();
    callback clear-clicked();
    callback cycle-policy-clicked();
    callback toggle-cab-bypass-clicked();

    background: transparent;

    VerticalLayout {
        spacing: 3px;
        alignment: space-between;

        // Header Title
        HorizontalLayout {
            alignment: space-between;
            height: 12px;
            Text {
                text: "CABINET";
                font-size: 8.5px;
                font-weight: 700;
                color: #8fa1b3;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 3px;
                if (!root.has-ir || !root.cab-is-neural) : touch_policy := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.cycle-policy-clicked();
                    }
                    Rectangle {
                        background: touch_policy.has-hover ? #252b36 : #1a1e26;
                        border-radius: 2px;
                        border-width: 0.5px;
                        border-color: touch_policy.has-hover ? root.accent-color : #3b4252;
                        height: 12px;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: root.ir-policy-label;
                                font-size: 7.5px;
                                font-weight: 700;
                                color: #d8dee9;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if root.has-ir && root.cab-is-neural : Rectangle {
                    background: #1a1e26;
                    border-radius: 2px;
                    border-width: 0.5px;
                    border-color: #3b4252;
                    height: 12px;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: "UNITY";
                            font-size: 7px;
                            font-weight: 700;
                            color: #88c0d0;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.has-ir : Rectangle {
                    background: root.cab-is-neural ? #242138 : #1b2838;
                    border-radius: 2px;
                    border-width: 0.5px;
                    border-color: root.cab-is-neural ? #b48ead : #3498db;
                    height: 12px;
                    HorizontalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        Text {
                            text: root.cab-kind-label;
                            font-size: 7px;
                            font-weight: 800;
                            color: root.cab-is-neural ? #d8b4e2 : #81c4f0;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.has-ir || root.cab-bypassed : touch_cab_bypass := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-cab-bypass-clicked();
                    }
                    Rectangle {
                        background: root.cab-bypassed ? #332718 : #1c3628;
                        border-radius: 2px;
                        border-width: 0.5px;
                        border-color: touch_cab_bypass.has-hover ? #ffffff : (root.cab-bypassed ? #EBCB8B : #43E97B);
                        height: 12px;
                        HorizontalLayout {
                            padding-left: 3px;
                            padding-right: 3px;
                            Text {
                                text: root.cab-bypassed ? "BYP" : "ON";
                                font-size: 7px;
                                font-weight: 800;
                                color: root.cab-bypassed ? #EBCB8B : #43E97B;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Active Cabinet Display Surface
        Rectangle {
            height: 36px;
            background: #141518;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.is-error ? #F74E4E : (root.has-ir && root.cab-bypassed ? #EBCB8B : #2E3440);
            clip: true;

            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                alignment: center;
                spacing: 1px;

                if root.is-loading : Text {
                    text: "Loading cabinet...";
                    font-size: 9px;
                    font-weight: 600;
                    color: #F5A623;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if root.is-error : Text {
                    text: root.error-message != "" ? root.error-message : "Cabinet load failed";
                    font-size: 8.5px;
                    font-weight: 600;
                    color: #F74E4E;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if !root.is-loading && !root.is-error : Text {
                    text: root.ir-name;
                    font-size: 9.5px;
                    font-weight: 600;
                    color: !root.has-ir ? #8fa1b3 : (root.cab-bypassed ? #EBCB8B : #E5E9F0);
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if !root.is-error : Text {
                    text: !root.has-ir
                        ? (root.cab-bypassed ? "Bypassed • No cabinet loaded" : "Select .wav IR or 1x1 .nam/.namb")
                        : (root.cab-bypassed
                            ? ("Bypassed (latency kept) • " + root.ir-status)
                            : (root.cab-is-neural
                                ? ("+CPU/lat • " + root.ir-status + (root.cab-detail != "" ? (" • " + root.cab-detail) : ""))
                                : ("Active • " + root.ir-status)));
                    font-size: 7.5px;
                    color: !root.has-ir ? #636e7b : (root.cab-bypassed ? #EBCB8B : (root.cab-is-neural ? #88C0D0 : #43E97B));
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Action Trigger Row (Load Cabinet + Contextual Clear)
        HorizontalLayout {
            spacing: 3px;
            height: 24px;

            SelectorButton {
                text: "LOAD CAB";
                badge: root.has-ir ? root.cab-kind-label : "WAV/NAM";
                accent-color: root.accent-color;
                clicked => {
                    root.load-clicked();
                }
            }

            if root.has-ir : touch_clear := TouchArea {
                width: 24px;
                mouse-cursor: pointer;
                clicked => {
                    root.clear-clicked();
                }

                Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    background: touch_clear.pressed ? #171012 : (touch_clear.has-hover ? #2e1a1d : #201517);
                    border-color: touch_clear.has-hover ? #F74E4E : #3a2226;
                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }

                    Text {
                        text: "✕";
                        font-size: 11px;
                        font-weight: 800;
                        color: touch_clear.has-hover ? #ffffff : #F74E4E;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: 100ms; }
                    }
                }
            }
        }
    }
}
