# Single source of truth for pinned upstream/sibling dependencies in NAM-Plug.
# Version-controlled in this repository. Sourced or parsed by CI workflows.

# Pinned sibling engine (NeuralAmpModeler-rs)
# ENGINE_TAG stays "unreleased" until the engine publishes a tag that contains
# the fail-closed Wavenet error-code mapping required by NAM-Plug's loader.
# ENGINE_COMMIT is the source of truth for CI and local source builds.
ENGINE_REPO="fabiohl/NeuralAmpModeler-rs"  # owner/repo consumed by actions/checkout
ENGINE_TAG="unreleased"
ENGINE_COMMIT="07428b4081a8c75ab80eac4a59190f82dc610805"

# Pinned external testing tools
CLAP_VALIDATOR_VERSION="0.4.1"
CLAP_VALIDATOR_URL="https://github.com/free-audio/clap-validator/releases/download/0.4.1/clap-validator-0.4.1-127-g152b982-ubuntu-22.04.zip"
CLAP_VALIDATOR_SHA256="49edadcfb407ea0dd946ce418300e853fbd2660fa4b0d00e4f19ff8eef24ad90"
